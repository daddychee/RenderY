# Copy file này thành .env rồi điền key thật. KHÔNG commit .env.
# ANTHROPIC_API_KEY: KHÔNG cần — NÃO chạy qua Claude Code subscription. Chỉ điền nếu
# dùng fallback --engine api (director) / --engine claude (vision). User chốt 2026-07-09.
# ANTHROPIC_API_KEY=

# ── NGUỒN STOCK (free, dùng thương mại được) ─────────────────────────────────
# Thứ tự chạy: Pexels trước; Pixabay bù khi Pexels nghèo ứng viên hoặc hết hạn mức.
# Cần ÍT NHẤT MỘT trong hai.

# Pexels — key free tại https://www.pexels.com/api/  (~200 query/giờ/key)
PEXELS_API_KEY=

# Pixabay — key free tại https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Nhiều key = nhân hạn mức. Khai kiểu nào cũng được:
#   PEXELS_API_KEY=key1, key2          (ngăn bằng dấu phẩy/khoảng trắng)
#   PEXELS_API_KEY_2=key2              (tới _10)
# Pixabay dùng cùng quy ước: PIXABAY_API_KEY_2 ... _10

# ── NGUỒN SUBSCRIPTION (đã trả tiền — tải qua trình duyệt, CÓ PHANH) ─────────
# Chỉ cần điền EMAIL để BẬT nguồn. Đăng nhập một lần bằng trình duyệt, phiên lưu
# ở .browser_profiles/ — kiểm tra bằng: rendery.bat sub-status
# ENVATO_EMAIL=ban@email.com
# VECTEEZY_EMAIL=ban@email.com
#
# Phanh chống khoá tài khoản (sửa trong sourcer/subscription.py nếu cần):
#   trần 20 clip/giờ · nghỉ ngẫu nhiên 6-18s · gặp captcha là DỪNG hẳn nguồn
# Artlist KHÔNG hỗ trợ — chỉ tải tay được, dùng `sub-links` để mở link nhanh.
